# ---------------------------------------------------------------------------
# Master Tuition Centre Website Engine — environment configuration
#
# Copy to `.env.local` for local development. On Vercel, set these per project:
# one Vercel project per centre, all pointing at this same repository.
# ---------------------------------------------------------------------------

# Which centre this deployment renders.
# Must match a directory name in `src/centres/` that is registered in
# `src/centres/index.ts`. An unknown value fails loudly at build/startup.
SITE_ID=demo-centre

# "demo" | "production"
#
# demo        Sales/concept deployment for a prospective centre.
#             - forms never transmit data anywhere (simulated submission only)
#             - every page emits `noindex, nofollow`
#             - robots.txt disallows all crawling
#             - an `X-Robots-Tag: noindex, nofollow` response header is sent
#             - no sitemap entries are produced
#             - a discreet "concept website" notice is rendered
#
# production  Live deployment for a paying centre.
#             - indexing, canonicals, sitemap and structured data enabled
#             - forms use the configured production submission adapter
SITE_MODE=demo

# Absolute origin for this deployment. Used for canonical URLs, Open Graph
# URLs, the sitemap and structured data. No trailing slash.
# Production indexing REQUIRES a valid https:// value here.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional — production form delivery.
# Only read when SITE_MODE=production. Left empty, the production adapter
# reports a clear "not configured" error instead of silently dropping leads.
# ---------------------------------------------------------------------------
# FORM_WEBHOOK_URL=https://example.com/api/leads

# ---------------------------------------------------------------------------
# Optional — analytics. Left unset, no analytics code is loaded at all.
# Form field values are never sent to analytics in any mode.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
